# Copiar a api/.env y completar. Nunca subir .env al repositorio (SQAP, Sección 10.5).
DATABASE_URL=postgresql://calis:calis@localhost:55432/calis
REDIS_URL=redis://localhost:6379
JWT_SECRET=pruebas-sistema-completa-sin-fallas
JWT_EXPIRES_IN=30m
PORT=3000
CORS_ORIGINS=http://localhost:5173
# CAL-003: inicios de sesión permitidos por minuto y por IP (0 lo desactiva; por defecto 10) y saltos de proxy de
# confianza para leer la IP real (Render con Cloudflare: 2; en local, 0).
LIMITE_LOGIN_POR_MINUTO=10
TRUST_PROXY=0
# T-061/T-062 (ADR-0011): correo por la API de Brevo. Sin CORREO_API_KEY los avisos quedan solo dentro del sistema.
# CORREO_REMITENTE debe estar verificado en Brevo. Fuera de producción, CORREO_REDIRIGIR_A manda todo a una casilla.
CORREO_API_KEY=
CORREO_REMITENTE=
CORREO_REDIRIGIR_A=
WEB_URL=http://localhost:5173

# Web (web/.env)
VITE_API_URL=http://localhost:3000/api
