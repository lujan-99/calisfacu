# Copiar a jenkins/.env (no se versiona)
# Versión del SonarScanner CLI: tomarla de https://binaries.sonarsource.com/?prefix=Distribution/sonar-scanner-cli/
SONAR_SCANNER_VERSION=
STAGING_API_URL=https://calisfacu-api-staging.onrender.com
STAGING_WEB_URL=https://calisfacu-web-staging.onrender.com
# Análisis estático con SonarQube Cloud: poner true cuando esté configurado (T-030, Sprint 2)
SONAR_HABILITADO=false
